# Copy to .env.local and fill in real values. .env* files are gitignored; this
# file is the documentation of what the app needs. Never put real keys in here.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — bypasses RLS. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Later (AI hints, AI-1 to AI-4):
# OPENAI_BASE_URL=https://ai.ohack.dev/v1      # OHack AI gateway (see your team card)
# OPENAI_API_KEY=sk-your-key                   # keep the real one in .env.local only
